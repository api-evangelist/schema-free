    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The MongoDB Atlas Data API exposes HTTPS endpoints over Atlas clusters,\nletting clients perform CRUD and aggregation operations against MongoDB\ncollections without a driver. Each App Services application has its own\nbase URL containing the app ID. Authentication is via API key passed in\nthe `apiKey` header. NOTE: MongoDB has marked the Data API as end-of-life;\nthis file is retained as an API Evangelist research artifact for the\nschema-free topic.\n\n\nContact Support:\n Name: API Evangelist",
      "type": "text/plain"
    }
  }

{
  "opencollection": "1.0.0",
  "info": {
    "name": "MongoDB Atlas Data API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Documents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Insert one document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mongodb-api.com/app/{APP_ID}/endpoint/data/v1/action/insertOne",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Insert one document"
        },
        {
          "info": {
            "name": "Insert many documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mongodb-api.com/app/{APP_ID}/endpoint/data/v1/action/insertMany",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Insert many documents"
        },
        {
          "info": {
            "name": "Find one document",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://data.mongodb-api.com/app/{APP_ID}/endpoint/data/v1/action/findOne",
